from scipy import stats # to calculate mode
import numpy as np
weights = [45,45,47,65,66,50,54,53,55,53,55,52,70,80,99,89,55,65,61,55]
mn = np.mean(weights)
print("Mean or average weight of class is:", mn)
me = np.median(weights)
print("Median or middle value of weights in class is:", me)
mo = stats.mode(weights)
print("Mode or most occurring value in weights is:", mo)
